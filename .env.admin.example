# YALNIZCA yerel yönetim betikleri içindir (npm run demo:kullanicilar).
# Bu dosyayı .env.admin olarak kopyalayın. .env.admin git'e eklenmez.
# Secret key tüm RLS kurallarını atlar: paylaşmayın, tarayıcı koduna koymayın.
#   Project Settings → API Keys → Secret keys (sb_secret_...)

SUPABASE_URL=https://<proje-ref>.supabase.co
SUPABASE_SECRET_KEY=sb_secret_xxxxxxxxxxxxxxxxxxxx

# İsteğe bağlı: tüm demo hesapları için ortak şifre (en az 10 karakter, harf + rakam).
# Boş bırakılırsa her hesaba rastgele şifre üretilir ve yalnızca bir kez ekrana yazılır.
ARMA_DEMO_PASSWORD=

# İsteğe bağlı: demo e-posta alan adı (varsayılan arma-demo.test)
# ARMA_DEMO_EMAIL_DOMAIN=arma-demo.test
