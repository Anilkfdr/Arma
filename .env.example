# Arma web uygulaması — tarayıcıya gömülen ayarlar.
# Bu dosyayı .env.local olarak kopyalayın ve değerleri Supabase panelinden alın:
#   Project Settings → API (Data API) → Project URL
#   Project Settings → API Keys → Publishable key (sb_publishable_...)
# Not: Publishable/anon anahtarı tarayıcıda görünür; güvenlik RLS politikalarıyla sağlanır.
# Secret / service_role anahtarını BU DOSYAYA KOYMAYIN.

VITE_SUPABASE_URL=https://<proje-ref>.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxx

# Eski tip anahtar kullanılıyorsa publishable yerine bu da çalışır:
# VITE_SUPABASE_ANON_KEY=eyJ...

# Yönlendirme biçimi: web için "browser". İleride Electron içinde dosyadan açarken "hash".
VITE_ROUTER_MODE=browser
